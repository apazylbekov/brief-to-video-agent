# Copy to .env and fill in. Only needed for VIDEO_MODE=live.

# Higgsfield API key as key_id:secret (read by higgsfield-client)
HF_KEY=
# Gemini API key for clip QA (read by google-genai; GOOGLE_API_KEY wins if both are set)
GEMINI_API_KEY=

# mock (default, $0, no network) or live
VIDEO_MODE=mock
# Hard cap on Higgsfield spend per run, in USD
MAX_SPEND_USD=8
