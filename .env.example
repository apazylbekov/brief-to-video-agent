# Copy to .env and fill in. Only needed for VIDEO_MODE=live.

# Higgsfield API key as key_id:secret (read by higgsfield-client)
HF_KEY=
# Gemini API key. Brief search uses it for embeddings whenever it is set, in any VIDEO_MODE
# (without it, keyword scores). Clip QA reads it via google-genai, where GOOGLE_API_KEY wins.
GEMINI_API_KEY=

# mock (default, $0, no network) or live
VIDEO_MODE=mock
# Cap on total Higgsfield spend logged in runs/runs.csv (all runs), in USD
MAX_SPEND_USD=8
